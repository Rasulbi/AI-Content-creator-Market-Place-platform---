# =============================================================================
# AI Content Creator Marketplace - Environment Variables
# Duplicate this file to `.env.local` and substitute with your actual credentials
# =============================================================================

# 1. Supabase Project Configuration (Required for live Supabase backend)
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: Application Base URL for auth redirects (password recovery & OAuth)
# Defaults to window.location.origin in browser; specify for production or SSR callback accuracy
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Supabase Service Role Key (Required for server-side admin actions & grading)
# Found in: Supabase Dashboard -> Project Settings -> API -> service_role (secret)
# IMPORTANT: Keep strictly secret. Never expose to client-side code.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# 3. Direct PostgreSQL Connection String (Optional - for Prisma/Drizzle/migrations)
# Found in: Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# 4. AI Provider Configuration (Server-side only)
# Select active provider: "gemini" (primary), "openrouter", or "groq" / "grok" (alternative)
AI_PROVIDER=gemini

# Specify the model ID to use (never hardcoded in application logic)
# Examples:
#   Gemini:     gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
#   OpenRouter: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet, meta-llama/llama-3.3-70b-instruct
#   Groq:       llama-3.3-70b-versatile, mixtral-8x7b-32768
AI_MODEL=gemini-flash-latest
GEMINI_MODEL=gemini-flash-latest

# Primary Provider: Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Alternative Provider: OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# Alternative Provider: Groq Cloud API Key (https://console.groq.com/keys)
GROQ_API_KEY="your-groq-api-key-here"

# Alternative Provider: xAI Grok API Key (https://console.x.ai/)
#XAI_API_KEY=

# 5. Direct OpenAI API Key (For AI Content Studio: hooks, captions, scripts)
# Found in: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key-here"
# Optional: specify OpenAI model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# 6. AI Rate Limiting & Safety Controls (Server-Side)
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_REQUESTS=30


